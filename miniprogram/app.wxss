/* app.wxss - 全局样式 */

page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 32rpx;
  color: #333333;
  line-height: 1.6;
}

/* 适老化：确保最小可读字体 */
text, view {
  font-size: 32rpx;
}

/* 全局容器 */
.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 卡片通用样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 主题色按钮 */
.btn-primary {
  background-color: #E8553A;
  color: #FFFFFF;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 次要按钮 */
.btn-secondary {
  background-color: #FFF0ED;
  color: #E8553A;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-secondary::after {
  border: none;
}

/* 禁用状态 */
.btn-disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  text-align: center;
  border: none;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-active {
  background-color: #E8553A;
  color: #FFFFFF;
}

.tag-normal {
  background-color: #F0F0F0;
  color: #666666;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #EEEEEE;
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state text {
  color: #999999;
  font-size: 30rpx;
  margin-top: 24rpx;
}

/* 安全区域底部 padding */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}
