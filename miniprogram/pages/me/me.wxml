<!--pages/me/me.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="profile-card card">
    <view class="profile-top">
      <!-- 头像：使用 button + open-type="chooseAvatar" -->
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image
          class="avatar"
          wx:if="{{hasAvatar}}"
          src="{{avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view class="avatar avatar-placeholder" wx:else>
          <text class="placeholder-icon">👤</text>
          <text class="avatar-tip">点击设置</text>
        </view>
      </button>

      <!-- 昵称：使用 input type="nickname" -->
      <view class="profile-info">
        <view class="nick-name-row" wx:if="{{hasNickName}}">
          <text class="nick-name">{{nickName}}</text>
          <input
            class="nick-name-input-hidden"
            type="nickname"
            value="{{nickName}}"
            bindblur="onNickNameChange"
            placeholder="修改昵称"
          />
          <text class="edit-icon">✏️</text>
        </view>
        <view class="nick-name-row" wx:else>
          <input
            class="nick-name-input"
            type="nickname"
            placeholder="点击设置昵称"
            bindblur="onNickNameChange"
          />
        </view>
        <view class="profile-desc">享受精彩的退休生活 🎉</view>
      </view>
    </view>

    <!-- 手机号 -->
    <view class="phone-row">
      <view class="phone-label">📱 手机号</view>
      <view class="phone-value" wx:if="{{hasPhone}}">
        <text>{{phoneNumber}}</text>
      </view>
      <block wx:else>
        <!-- 模拟模式：普通 view 点击 -->
        <view class="phone-btn" wx:if="{{isMock}}" bindtap="onMockGetPhone">
          点击获取手机号
        </view>
        <!-- 正式模式：button open-type -->
        <button
          class="phone-btn phone-btn-real"
          wx:else
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >
          点击获取手机号
        </button>
      </block>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view
      class="menu-item card"
      wx:for="{{menuList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <view class="menu-info">
        <view class="menu-name">{{item.name}}</view>
        <view class="menu-desc">{{item.desc}}</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">最美你和我 v1.0</text>
  </view>
</view>
