<!--pages/me/me.wxml-->
<view class="page-container">
  <!-- 顶部个人信息区 -->
  <view class="profile-hero">
    <view class="profile-hero-bg"></view>
    <view class="profile-content safe-top">
      <view class="profile-top">
        <!-- 头像 -->
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="avatar" wx:if="{{hasAvatar}}" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view class="avatar avatar-placeholder" wx:else>
            <text class="placeholder-icon">👤</text>
          </view>
          <view class="avatar-edit-badge">✏️</view>
        </button>

        <!-- 昵称 -->
        <view class="profile-info">
          <view class="nick-name-row" wx:if="{{hasNickName}}">
            <text class="nick-name">{{nickName}}</text>
            <input class="nick-name-input-hidden" type="nickname" value="{{nickName}}" bindblur="onNickNameChange" placeholder="修改昵称" />
            <view class="edit-tag">编辑</view>
          </view>
          <view class="nick-name-row" wx:else>
            <input class="nick-name-input" type="nickname" placeholder="点击设置昵称" bindblur="onNickNameChange" />
          </view>

          <!-- 手机号 -->
          <view class="phone-line">
            <text class="phone-icon">📱</text>
            <view class="phone-value" wx:if="{{hasPhone}}">
              <text>{{phoneNumber}}</text>
            </view>
            <block wx:else>
              <view class="phone-link" wx:if="{{isMock}}" bindtap="onMockGetPhone">
                绑定手机号
              </view>
              <button class="phone-link" wx:else open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
                绑定手机号
              </button>
            </block>
          </view>
        </view>
      </view>

      <!-- 数据统计 -->
      <view class="stats-bar">
        <view class="stat-item">
          <text class="stat-num">2</text>
          <text class="stat-label">已发布</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">3</text>
          <text class="stat-label">已参与</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">8</text>
          <text class="stat-label">收藏</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">我的活动</view>

    <view
      class="menu-item card card-hover"
      data-key="myPublished"
      bindtap="onMenuTap"
    >
      <view class="menu-icon-box" style="background: rgba(212,81,94,0.08)">
        <text>📋</text>
      </view>
      <view class="menu-info">
        <view class="menu-name">我发布的活动</view>
        <view class="menu-desc">管理你发布的活动</view>
      </view>
      <view class="menu-right">
        <text class="menu-badge">2</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view
      class="menu-item card card-hover"
      data-key="myRegistered"
      bindtap="onMenuTap"
    >
      <view class="menu-icon-box" style="background: rgba(76,175,80,0.08)">
        <text>✅</text>
      </view>
      <view class="menu-info">
        <view class="menu-name">我参与的活动</view>
        <view class="menu-desc">查看已报名的活动</view>
      </view>
      <view class="menu-right">
        <text class="menu-badge">3</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="menu-section">
    <view class="menu-title">更多服务</view>

    <view class="menu-item card card-hover" bindtap="onAboutTap">
      <view class="menu-icon-box" style="background: rgba(66,133,244,0.08)">
        <text>ℹ️</text>
      </view>
      <view class="menu-info">
        <view class="menu-name">关于我们</view>
        <view class="menu-desc">了解最美你和我</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item card card-hover" bindtap="onFeedbackTap">
      <view class="menu-icon-box" style="background: rgba(255,152,0,0.08)">
        <text>💬</text>
      </view>
      <view class="menu-info">
        <view class="menu-name">意见反馈</view>
        <view class="menu-desc">帮助我们做得更好</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">最美你和我 v1.0</text>
  </view>
</view>
