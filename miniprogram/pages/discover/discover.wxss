/* pages/discover/discover.wxss */

.page-container {
  padding-bottom: 140rpx;
}

/* 头部 */
.discover-header {
  padding: 32rpx 28rpx 16rpx;
}

.discover-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.discover-subtitle {
  font-size: 28rpx;
  color: #999999;
}

/* 分类网格 */
.category-section {
  padding: 12rpx 28rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-card {
  width: calc(25% - 12rpx);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.category-card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.category-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.category-card-count {
  font-size: 20rpx;
  color: #999999;
}

/* 推荐 */
.recommend-section {
  padding: 0 28rpx;
  margin-top: 16rpx;
}

.recommend-list {
  margin-top: 4rpx;
}

.recommend-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.recommend-card-left {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.recommend-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF0ED, #FFE0DA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.recommend-card-content {
  flex: 1;
  min-width: 0;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.recommend-meta {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.recommend-footer {
  display: flex;
  gap: 8rpx;
}

/* 底部标语 */
.discover-footer {
  padding: 60rpx 48rpx 32rpx;
  text-align: center;
}

.footer-slogan {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF0ED, #FFE8E3);
  padding: 16rpx 36rpx;
  border-radius: 36rpx;
}

.slogan-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.slogan-text {
  font-size: 26rpx;
  color: #D4515E;
  font-weight: 500;
}
