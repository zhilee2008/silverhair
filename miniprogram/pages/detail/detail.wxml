<!--pages/detail/detail.wxml-->
<view class="page-container" wx:if="{{activity}}">
  <!-- 顶部渐变头图 -->
  <view class="detail-hero">
    <view class="detail-hero-bg" style="background: linear-gradient(135deg, {{activity.status === 'open' ? '#D4515E, #E8726E' : activity.status === 'full' ? '#FF9800, #FFB74D' : '#999, #BBB'}})">
      <view class="detail-hero-icon">
        {{activity.category === 'square_dance' ? '💃' : activity.category === 'instrument' ? '🎵' : activity.category === 'taichi' ? '🥋' : activity.category === 'calligraphy' ? '🎨' : activity.category === 'chorus' ? '🎤' : activity.category === 'chess' ? '♟️' : activity.category === 'hiking' ? '🚶' : '🎯'}}
      </view>
      <view class="detail-hero-title">{{activity.title}}</view>
      <view class="detail-hero-tags">
        <view class="hero-tag">{{activity.categoryName}}</view>
        <view class="hero-tag hero-tag-{{activity.status}}">
          {{activity.status === 'open' ? '报名中' : activity.status === 'full' ? '已满员' : activity.status === 'ended' ? '已结束' : '已取消'}}
        </view>
      </view>
    </view>
    <!-- 曲线底部 -->
    <view class="detail-hero-curve"></view>
  </view>

  <!-- 组织者信息 -->
  <view class="organizer-bar card">
    <view class="organizer-avatar">👤</view>
    <view class="organizer-info">
      <view class="organizer-name">{{activity.organizer.nickName || '热心邻居'}}</view>
      <view class="organizer-label">活动发起人</view>
    </view>
    <view class="organizer-date">{{activity.createTime ? activity.createTime.substring(0, 10) : ''}} 发布</view>
  </view>

  <!-- 时间地点信息 -->
  <view class="info-card card">
    <view class="info-row" bindtap="onViewMap">
      <view class="info-icon-box" style="background: rgba(212,81,94,0.08)">
        <text>📅</text>
      </view>
      <view class="info-content">
        <view class="info-label">活动时间</view>
        <view class="info-value">{{activity.date}} {{activity.startTime}} - {{activity.endTime}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="info-row" bindtap="onViewMap">
      <view class="info-icon-box" style="background: rgba(66,133,244,0.08)">
        <text>📍</text>
      </view>
      <view class="info-content">
        <view class="info-label">活动地点</view>
        <view class="info-value">{{activity.location.name}}</view>
        <view class="info-sub" wx:if="{{activity.location.address}}">{{activity.location.address}}</view>
      </view>
      <view class="info-action">
        <text class="map-link">地图 ›</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="info-row">
      <view class="info-icon-box" style="background: rgba(76,175,80,0.08)">
        <text>👥</text>
      </view>
      <view class="info-content">
        <view class="info-label">参与人数</view>
        <view class="info-value">
          <text class="people-current">{{activity.currentParticipants}}</text>
          <text class="people-max"> / {{activity.maxParticipants}} 人</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{activity.currentParticipants / activity.maxParticipants * 100}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 活动介绍 -->
  <view class="desc-card card">
    <view class="section-title">活动介绍</view>
    <view class="description">{{activity.description || '暂无详细介绍'}}</view>
    <!-- 标签 -->
    <view class="desc-tags" wx:if="{{activity.tags && activity.tags.length > 0}}">
      <view class="tag tag-orange" wx:for="{{activity.tags}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="bar-share-btn" open-type="share">
      <text class="bar-share-icon">🔄</text>
      <text class="bar-share-text">分享</text>
    </button>

    <block wx:if="{{isOrganizer}}">
      <view class="btn-secondary bar-action-btn" bindtap="onCancelActivity" wx:if="{{activity.status === 'open'}}">
        取消活动
      </view>
    </block>

    <block wx:else>
      <view class="btn-secondary bar-action-btn" wx:if="{{isRegistered && activity.status === 'open'}}" bindtap="onCancelRegister">
        取消报名
      </view>
      <view class="btn-primary bar-action-btn" wx:elif="{{activity.status === 'open'}}" bindtap="onRegister">
        立即报名
      </view>
      <view class="btn-disabled bar-action-btn" wx:elif="{{activity.status === 'full'}}">
        已满员
      </view>
      <view class="btn-disabled bar-action-btn" wx:elif="{{activity.status === 'ended'}}">
        已结束
      </view>
    </block>
  </view>
</view>
