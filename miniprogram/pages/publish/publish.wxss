/* pages/publish/publish.wxss */

.page-container {
  padding-bottom: 180rpx;
}

/* 头部 */
.publish-header {
  padding: 28rpx 28rpx 8rpx;
}

.publish-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.publish-desc {
  font-size: 28rpx;
  color: #999999;
}

/* 表单卡片 */
.form-card {
  padding: 28rpx;
  margin: 16rpx 28rpx;
}

.form-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.form-card-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

/* 表单项 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.required { color: #D4515E; }

.form-input {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 2rpx solid transparent;
  transition: border 0.2s;
}

.form-input:focus {
  border-color: #D4515E;
  background: #FFFFFF;
}

.form-count {
  text-align: right;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* 分类 chips */
.category-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  color: #666666;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.chip-active {
  background: rgba(212, 81, 94, 0.08);
  color: #D4515E;
  border-color: #D4515E;
  font-weight: 600;
}

/* 表单行 */
.form-row {
  display: flex;
  gap: 16rpx;
}

.form-group-half {
  flex: 1;
}

/* 选择器 */
.form-picker {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 12rpx;
}

.form-picker-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.form-picker-content {
  flex: 1;
}

.form-picker-value {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.form-picker-sub {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-top: 4rpx;
}

.form-picker-placeholder {
  flex: 1;
  font-size: 30rpx;
  color: #BBBBBB;
}

.form-picker-arrow {
  color: #CCCCCC;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 数字输入 */
.number-input {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  overflow: hidden;
}

.number-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #D4515E;
  background: rgba(212, 81, 94, 0.06);
  font-weight: 600;
}

.number-btn:active {
  background: rgba(212, 81, 94, 0.12);
}

.number-value {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  background: transparent;
}

.number-unit {
  padding-right: 24rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 文本域 */
.form-textarea {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border 0.2s;
}

.form-textarea:focus {
  border-color: #D4515E;
  background: #FFFFFF;
}

/* 图片 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0; right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border-radius: 0 16rpx 0 10rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
}

.image-add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 6rpx;
}

/* 提交 */
.submit-area {
  padding: 16rpx 28rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}
