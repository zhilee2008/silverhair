/* pages/publish/publish.wxss */

.container {
  padding-bottom: 180rpx;
}

/* 表单区块 */
.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #E8553A;
}

.form-input {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #333333;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  background-color: #F0F0F0;
  color: #666666;
  font-size: 28rpx;
}

.category-item-active {
  background-color: #E8553A;
  color: #FFFFFF;
}

/* 表单行 */
.form-row {
  display: flex;
  gap: 20rpx;
}

.form-section-half {
  flex: 1;
}

/* 选择器 */
.form-picker {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #333333;
}

.placeholder {
  color: #999999;
}

/* 地点选择 */
.location-picker {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-info {
  flex: 1;
}

.location-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  display: block;
}

.location-address {
  font-size: 26rpx;
  color: #888888;
  margin-top: 4rpx;
  display: block;
}

.arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 0 12rpx 0 8rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
}

.add-icon {
  font-size: 60rpx;
  color: #CCCCCC;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 文本域 */
.form-textarea {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
}

/* 提交区域 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
