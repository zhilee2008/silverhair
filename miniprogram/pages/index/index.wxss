/* pages/index/index.wxss */

.container {
  padding-bottom: 20rpx;
}

/* 头部 */
.header {
  padding: 20rpx 24rpx 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #888888;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
}

.category-tag {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #F0F0F0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.category-tag-active {
  background-color: #E8553A;
  color: #FFFFFF;
}

/* 活动列表 */
.activity-list {
  padding: 0 24rpx;
}

/* 活动卡片 */
.activity-card {
  display: flex;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 0;
}

.activity-card:active {
  opacity: 0.9;
}

/* 活动图片 */
.activity-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.activity-img {
  width: 220rpx;
  height: 220rpx;
}

.activity-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE8E3, #FFD4CC);
}

.placeholder-text {
  font-size: 28rpx;
  color: #E8553A;
  font-weight: 500;
}

/* 活动信息 */
.activity-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.activity-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

/* 元信息 */
.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.meta-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.meta-text {
  font-size: 24rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部标签 */
.activity-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.activity-category-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background-color: #FFF0ED;
  color: #E8553A;
}

.tag-small {
  font-size: 22rpx;
}

.activity-status {
  font-size: 24rpx;
  font-weight: 500;
}

.status-open {
  color: #07C160;
}

.status-full {
  color: #FF9500;
}

.status-ended {
  color: #999999;
}

.status-cancelled {
  color: #FF3B30;
}

/* 加载/空状态 */
.loading-box,
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
}
