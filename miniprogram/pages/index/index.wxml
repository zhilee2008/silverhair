<!--pages/index/index.wxml-->
<view class="page-container">
  <!-- 顶部渐变区域 -->
  <view class="header-area">
    <view class="header-bg"></view>
    <view class="header-content safe-top">
      <!-- 顶部栏 -->
      <view class="top-bar">
        <view class="app-title">最美你和我</view>
        <view class="search-box" bindtap="onSearchTap">
          <text class="search-icon">🔍</text>
          <text class="search-placeholder">搜索活动、地点...</text>
        </view>
      </view>

      <!-- 轮播图 -->
      <swiper class="banner-swiper" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#FFFFFF" circular autoplay interval="4000" wx:if="{{banners.length > 0}}">
        <swiper-item wx:for="{{banners}}" wx:key="id" data-index="{{index}}" bindtap="onBannerTap">
          <view class="banner-card" style="background: {{item.gradient}}">
            <view class="banner-text">
              <view class="banner-title">{{item.title}}</view>
              <view class="banner-subtitle">{{item.subtitle}}</view>
            </view>
            <view class="banner-icon">{{item.icon}}</view>
          </view>
        </swiper-item>
      </swiper>
    </view>
  </view>

  <!-- 分类横滑 -->
  <view class="category-section">
    <scroll-view class="category-scroll" scroll-x enable-flex>
      <view
        class="category-pill {{currentCategory === item.key ? 'category-pill-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        <text class="category-pill-icon">{{item.icon}}</text>
        <text class="category-pill-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 热门推荐（仅全部时显示） -->
  <view class="hot-section" wx:if="{{currentCategory === 'all' && hotActivities.length > 0}}">
    <view class="section-header">
      <view class="section-title">热门推荐</view>
    </view>
    <scroll-view class="hot-scroll" scroll-x enable-flex>
      <view
        class="hot-card"
        wx:for="{{hotActivities}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onActivityTap"
      >
        <view class="hot-card-cover">
          <view class="hot-card-category">{{item.categoryName}}</view>
          <view class="hot-card-icon">{{item.category === 'square_dance' ? '💃' : item.category === 'instrument' ? '🎵' : item.category === 'taichi' ? '🥋' : item.category === 'calligraphy' ? '🎨' : item.category === 'chorus' ? '🎤' : item.category === 'chess' ? '♟️' : item.category === 'hiking' ? '🚶' : '🎯'}}</view>
        </view>
        <view class="hot-card-info">
          <view class="hot-card-title text-ellipsis">{{item.title}}</view>
          <view class="hot-card-meta">
            <text>📅 {{item.date}}</text>
          </view>
          <view class="hot-card-meta">
            <text>📍 {{item.location.name}}</text>
          </view>
          <view class="hot-card-footer">
            <view class="hot-card-people">👥 {{item.currentParticipants}}/{{item.maxParticipants}}</view>
            <view class="tag tag-{{item.status === 'open' ? 'success' : item.status === 'full' ? 'warning' : 'primary'}}">
              {{item.status === 'open' ? '报名中' : item.status === 'full' ? '已满' : '已结束'}}
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-section">
    <view class="section-header">
      <view class="section-title">{{currentCategory === 'all' ? '全部活动' : '筛选结果'}}</view>
    </view>

    <view wx:if="{{activityList.length > 0}}" class="activity-list">
      <view
        class="activity-item card card-hover"
        wx:for="{{activityList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onActivityTap"
      >
        <view class="activity-item-left">
          <view class="activity-item-icon">
            {{item.category === 'square_dance' ? '💃' : item.category === 'instrument' ? '🎵' : item.category === 'taichi' ? '🥋' : item.category === 'calligraphy' ? '🎨' : item.category === 'chorus' ? '🎤' : item.category === 'chess' ? '♟️' : item.category === 'hiking' ? '🚶' : '🎯'}}
          </view>
        </view>
        <view class="activity-item-content">
          <view class="activity-item-title text-ellipsis">{{item.title}}</view>
          <view class="activity-item-meta">
            <text class="meta-item">📅 {{item.date}} {{item.startTime}}</text>
            <text class="meta-item">📍 {{item.location.name}}</text>
          </view>
          <view class="activity-item-footer">
            <view class="activity-item-tags">
              <view class="tag tag-primary" wx:if="{{item.categoryName}}">{{item.categoryName}}</view>
              <view class="tag tag-{{item.status === 'open' ? 'success' : item.status === 'full' ? 'warning' : 'primary'}}">
                {{item.status === 'open' ? '报名中' : item.status === 'full' ? '已满员' : item.status === 'ended' ? '已结束' : '已取消'}}
              </view>
            </view>
            <view class="activity-item-people">
              <text class="people-num">{{item.currentParticipants}}</text>
              <text class="people-total">/{{item.maxParticipants}}人</text>
            </view>
          </view>
        </view>
        <view class="activity-item-arrow">›</view>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-box" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && activityList.length > 0 && !loading}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经到底了</text>
      <view class="no-more-line"></view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && activityList.length === 0}}">
      <text class="empty-icon">🎯</text>
      <text class="empty-title">暂无活动</text>
      <text class="empty-desc">换个分类看看，或者发布一个新活动吧</text>
    </view>
  </view>
</view>
