<!--pages/myActivities/myActivities.wxml-->
<view class="page-container">
  <!-- Tab 切换 -->
  <view class="tabs">
    <view
      class="tab {{currentTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      <text class="tab-name">{{item.name}}</text>
      <view class="tab-line" wx:if="{{currentTab === item.key}}"></view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activity-list" wx:if="{{activityList.length > 0}}">
    <view
      class="activity-card card card-hover"
      wx:for="{{activityList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onActivityTap"
    >
      <view class="card-header">
        <view class="card-category">
          <view class="card-category-icon">
            {{item.category === 'square_dance' ? '💃' : item.category === 'instrument' ? '🎵' : item.category === 'taichi' ? '🥋' : item.category === 'calligraphy' ? '🎨' : item.category === 'chorus' ? '🎤' : item.category === 'chess' ? '♟️' : item.category === 'hiking' ? '🚶' : '🎯'}}
          </view>
          <text class="card-category-name">{{item.categoryName}}</text>
        </view>
        <view class="tag tag-{{item.status === 'open' ? 'success' : item.status === 'full' ? 'warning' : 'info'}}">
          {{item.status === 'open' ? '报名中' : item.status === 'full' ? '已满员' : item.status === 'ended' ? '已结束' : '已取消'}}
        </view>
      </view>

      <view class="card-title text-ellipsis">{{item.title}}</view>

      <view class="card-meta">
        <view class="card-meta-item">
          <text class="meta-dot">📅</text>
          <text>{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
        </view>
        <view class="card-meta-item">
          <text class="meta-dot">📍</text>
          <text class="text-ellipsis">{{item.location.name}}</text>
        </view>
      </view>

      <view class="card-footer">
        <view class="card-people">
          <text class="people-current">{{item.currentParticipants}}</text>
          <text class="people-max">/{{item.maxParticipants}}人</text>
        </view>
        <view class="card-arrow">查看详情 ›</view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && activityList.length === 0}}">
    <text class="empty-icon">{{currentTab === 'myPublished' ? '📝' : '📭'}}</text>
    <text class="empty-title">{{currentTab === 'myPublished' ? '还没有发布活动' : '还没有参与活动'}}</text>
    <text class="empty-desc">{{currentTab === 'myPublished' ? '去发布你的第一个活动吧' : '去看看有什么感兴趣的活动'}}</text>
  </view>
</view>
