<!--pages/myActivities/myActivities.wxml-->
<view class="container">
  <!-- 活动列表 -->
  <view wx:if="{{activityList.length > 0}}">
    <view
      class="activity-card card"
      wx:for="{{activityList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onActivityTap"
    >
      <view class="activity-title">{{item.title}}</view>
      <view class="activity-meta">
        <text class="meta-icon">📅</text>
        <text class="meta-text">{{item.date}} {{item.startTime}}</text>
      </view>
      <view class="activity-meta">
        <text class="meta-icon">📍</text>
        <text class="meta-text">{{item.location.name}}</text>
      </view>
      <view class="activity-meta">
        <text class="meta-icon">👥</text>
        <text class="meta-text">{{item.currentParticipants}}/{{item.maxParticipants}}人</text>
        <view class="activity-status status-{{item.status}}">
          {{item.status === 'open' ? '报名中' : item.status === 'full' ? '已满员' : item.status === 'ended' ? '已结束' : '已取消'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && activityList.length === 0}}">
    <text class="empty-icon">📭</text>
    <text>{{type === 'myPublished' ? '你还没有发布过活动' : '你还没有参与过活动'}}</text>
  </view>
</view>
